# Show help
cmd_help() {
    cat <<EOF
aptx v$VERSION - APT package manager with isolated environments

USAGE:
    aptx <command> [options]

COMMANDS:
    init [--mode=isolated|overlay]    Initialize aptx and create environment (default: isolated)
    deactivate                        Deactivate current environment
    shell                             Enter environment shell
    install <package1> [package2]... Install package(s) in current environment
    run <command>                     Run command in environment
    info                              Show environment info and packages
    export                            Export environment specification
    list                              List all environments
    clean                              Clean current environment and remove .aptx directory
    
    global init                       Initialize global environment for system-wide packages
    global install <package1> [package2]... Install package(s) globally (available system-wide automatically)
    global remove <package1> [package2]... Remove package(s) from global environment
    global info                       Show global environment info and packages

    global clean                      Remove global environment and all global packages
    
    help                              Show this help

EXAMPLES:
    aptx init --mode=isolated
    aptx shell
    aptx install gcc
    aptx install gcc nano tree
    aptx run apt install gcc
    aptx info
    aptx export
    aptx list
    aptx clean

MODES:
    isolated  - Completely isolated from system packages
    overlay   - Can use system packages when not available in environment

For more information, visit: https://github.com/yourusername/aptx
EOF
}

# Main command dispatcher
main() {
    local cmd="$1"
    
    case "$cmd" in
        init)
            local mode="isolated"  # default mode
            if [[ "$2" == --mode=* ]]; then
                mode="${2#--mode=}"
            elif [[ "$2" == --mode ]] && [[ -n "$3" ]]; then
                mode="$3"
            fi
            cmd_init "$mode"
            ;;

        deactivate)
            cmd_deactivate
            ;;
        shell)
            cmd_shell
            ;;
        install)
            cmd_install "${@:2}"
            ;;
        run)
            cmd_run "${@:2}"
            ;;
        info)
            cmd_info
            ;;
        export)
            cmd_export
            ;;
        list)
            cmd_list
            ;;
        clean)
            cmd_clean
            ;;
        global)
            local sub_cmd="$2"
            if [ -z "$sub_cmd" ]; then
                cmd_help
                exit 1
            fi
            shift 2
            case "$sub_cmd" in
                init) cmd_global_init ;;
                install) cmd_global_install "$@" ;;
                remove) cmd_global_remove "$@" ;;
                info) cmd_global_list ;;

                clean) cmd_global_clean ;;
                help)
                    cmd_global_help
                    ;;
                *)
                    log_error "Unknown global command: $sub_cmd"
                    log_info "Run 'aptx global help' for usage information"
                    exit 1
                    ;;
            esac
            ;;
        help|--help|-h)
            cmd_help
            ;;
        version|--version|-v)
            echo "aptx v$VERSION"
            ;;
        "")
            cmd_help
            ;;
        *)
            log_error "Unknown command: $cmd"
            log_info "Run 'aptx help' for usage information"
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
